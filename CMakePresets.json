{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "msys-ucrt64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/cmake-build-${presetName}",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/msys64/ucrt64",
        "Qt6_DIR": "C:/msys64/ucrt64/lib/cmake/Qt6",
        "NUMINA_ROOT": "C:/cpp/projects/static-libs/numina",
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe"
      },
      "environment": {
        "PATH": "C:\\msys64\\ucrt64\\bin;$penv{PATH}"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (MSYS2 UCRT64)",
      "inherits": "msys-ucrt64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (MSYS2 UCRT64)",
      "inherits": "msys-ucrt64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
